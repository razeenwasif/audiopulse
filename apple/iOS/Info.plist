<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Baked in at build time: xcodebuild ... SPOTIFY_CLIENT_ID=<id>. Empty means "ask in the app". -->
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<!-- Lets the Spotify SDK check for and open the Spotify app. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<!-- audiopulse://spotify-callback: sign-in and App Remote return here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.audiopulse.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>audiopulse</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
